{
  "name": "xadrez-total-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Aplicação desktop do Xadrez Total",
  "main": "desktop/main.cjs",
  "scripts": {
    "prestart": "node desktop/create-icon.cjs",
    "start": "electron .",
    "prebuild:win": "node desktop/create-icon.cjs",
    "build:win": "electron-builder --win portable --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "pt.xadrez.total",
    "productName": "Xadrez Total",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**/*",
      "public/**/*",
      "package.json"
    ],
    "win": {
      "icon": "desktop/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Xadrez-Total.exe"
    }
  },
  "author": {
    "name": "D-DMr"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/D-DMr/xadrez.git"
  },
  "overrides": {
    "minimatch": "^11.0.8"
  }
}
